# Required
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading

# Start the in-process hourly Strategy scheduler with the Next.js server
AUTO_START_STRATEGY=true

# Optional — only needed for manual `pnpm cron:trigger`
# CRON_SECRET=generate-a-long-random-string
# CRON_URL=http://localhost:3000/api/cron/run-strategy

# Optional — override Binance data API base URL
# BINANCE_API_BASE_URL=https://data-api.binance.vision

# Optional — backtest / ML cache directory (default: ./backtest-cache)
# BACKTEST_CACHE_DIR=backtest-cache

# Optional — web push. `pnpm start:local` / `pnpm push:setup` generates keys locally if missing.
# Production must set all three. Generate with: npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
